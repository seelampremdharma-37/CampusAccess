# CampusAccess — Environment Variables
# Copy to .env.local for dev; enter these in your host's dashboard for prod.

# ── REQUIRED ─────────────────────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
# Without it, the app still works using verified bundled fallbacks (demo-safe).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── OPTIONAL (only for split Vercel+Render deployment) ───
# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=""
# Frontend build env (Vercel): full origin of the Render API, e.g.
VITE_API_BASE_URL=""
